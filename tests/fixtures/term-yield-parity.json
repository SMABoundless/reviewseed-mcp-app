          { "label": "resilience", "kind": "keyword", "pool": "keywords", "field": "tiab", "selected": false, "from": "synonym", "seeds": [] },
          { "label": "Burnout, Professional", "kind": "mesh", "pool": "mesh", "field": null, "selected": true, "from": "seed", "seeds": ["1", "2"] },
          { "label": "Mindfulness", "kind": "mesh", "pool": "mesh", "field": null, "selected": true, "from": "vocab", "seeds": [] }
