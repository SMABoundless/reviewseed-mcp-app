          "burnout",
          "mindfulness"
        ],
        "mesh": [],
        "eric": [],
        "queries": [],
        "ericQueries": [],
        "ctQueries": []
      },
      "kwFields": {},
      "opts": {},
      "expected": "(\"burnout\"[tiab] OR \"mindfulness\"[tiab])"
