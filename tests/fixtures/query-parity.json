  "idClauseCases": [
    {
      "name": "pubmed uid clause",
      "source": "pubmed",
      "ids": [
        "31234567",
        "29876543"
      ],
      "expectedClause": "(31234567[uid] OR 29876543[uid])",
      "query": "\"gabapentin\"[tiab] OR \"pregabalin\"[tiab]",
      "expectedRestricted": "(\"gabapentin\"[tiab] OR \"pregabalin\"[tiab]) AND (31234567[uid] OR 29876543[uid])"
    },
    {
      "name": "eric id clause",
      "source": "eric",
      "ids": [
        "EJ1172285",
        "ED605432"
      ],
      "expectedClause": "(id:EJ1172285 OR id:ED605432)",
      "query": "subject:\"Distance Education\"",
      "expectedRestricted": "(subject:\"Distance Education\") AND (id:EJ1172285 OR id:ED605432)"
    },
    {
      "name": "trials NCTId area clause",
      "source": "trials",
      "ids": [
        "NCT04280705",
        "NCT04292899"
      ],
      "expectedClause": "AREA[NCTId](NCT04280705 OR NCT04292899)",
      "query": "AREA[BasicSearch]\"covid\"",
      "expectedRestricted": "(AREA[BasicSearch]\"covid\") AND AREA[NCTId](NCT04280705 OR NCT04292899)"
    },
    {
      "name": "single id needs no OR",
      "source": "pubmed",
      "ids": [
        "31234567"
      ],
      "expectedClause": "(31234567[uid])",
      "query": "asthma",
      "expectedRestricted": "(asthma) AND (31234567[uid])"
    },
    {
      "name": "no ids means no clause and no query",
      "source": "pubmed",
      "ids": [],
      "expectedClause": "",
      "query": "asthma",
      "expectedRestricted": ""
    },
    {
      "name": "blank ids are dropped, not emitted as empty terms",
      "source": "pubmed",
      "ids": [
        "31234567",
        "  ",
        ""
      ],
      "expectedClause": "(31234567[uid])",
      "query": "asthma",
      "expectedRestricted": "(asthma) AND (31234567[uid])"
    },
    {
      "name": "a multi-line framework query is flattened before restriction",
      "source": "pubmed",
      "ids": [
        "1"
      ],
      "expectedClause": "(1[uid])",
      "query": "(\"a\"[tiab])\nAND (\"b\"[tiab])",
      "expectedRestricted": "((\"a\"[tiab]) AND (\"b\"[tiab])) AND (1[uid])"
    },
    {
      "name": "an empty query restricts to the ids alone",
      "source": "pubmed",
      "ids": [
        "1",
        "2"
      ],
      "expectedClause": "(1[uid] OR 2[uid])",
      "query": "",
      "expectedRestricted": "(1[uid] OR 2[uid])"
    }
  ]
}
